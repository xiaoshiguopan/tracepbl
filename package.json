{
  "name": "tracepbl",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @tracepbl/web",
    "dev": "npm run dev --workspace @tracepbl/web",
    "lint": "npm run lint --workspace @tracepbl/web",
    "test": "npm run test --workspace @tracepbl/web",
    "typecheck": "npm run typecheck --workspace @tracepbl/web"
  },
  "engines": {
    "node": ">=24.19.0",
    "npm": ">=11.17.0"
  },
  "devDependencies": {
    "eslint": "10.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  }
}
