# Copy to .env for local Compose only. Use distinct random values; never commit .env.
TRACEPBL_POSTGRES_PASSWORD=replace-with-at-least-32-random-characters
TRACEPBL_APP_DB_PASSWORD=replace-with-a-different-32-character-value
TRACEPBL_WORKER_DB_PASSWORD=replace-with-another-32-character-value
TRACEPBL_SESSION_SECRET=replace-with-at-least-43-random-url-safe-characters

# AI and URL fetching stay off by default. Real GLM requires a separately authorized setup.
TRACEPBL_PROVIDER_MODE=disabled
TRACEPBL_AI_ENABLED=false
TRACEPBL_URL_FETCH_ENABLED=false

# Host execution only: choose an absolute directory outside this repository.
# Compose uses its independent tracepbl_recovery volume instead. Never remove it while backups remain.
# TRACEPBL_RECOVERY_JOURNAL=C:/TracePBL-Recovery/deletion-journal.json
# Reserved for a separately authorized real-provider setup; all three rates are required together.
# TRACEPBL_PRICE_PROFILE_VERSION=verified-price-version
# TRACEPBL_GENERATION_INPUT_CNY_PER_MILLION=
# TRACEPBL_GENERATION_OUTPUT_CNY_PER_MILLION=
# TRACEPBL_EMBEDDING_CNY_PER_MILLION=
